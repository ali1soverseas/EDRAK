# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environment
.env

# Frontend
node_modules/
frontend/dist/

# Docs (private, not published yet)
docs/

# Generated knowledge graph (graphify): graph.json is ~5MB and graph.html ~3.7MB
graphify-out/

# EDRAK runtime
data/*.db
data/*.db-wal
data/*.db-shm
data/*.v2.tmp*
# Uploaded originals (company files): never commit
data/uploads/
data/profiles/active_profile.json
data/internal/*.*
data/vector_store/
data/handbook/
artifacts/runs/*
artifacts/reports/*
artifacts/logs/
artifacts/competitor_runs/*
# Eval run products (reports_market_entry_Eval) and loose briefing dumps:
# generated per run, never source. Untrack what is already committed with:
#   git rm -r --cached artifacts/reports_market_entry_Eval
artifacts/reports_market_entry_Eval/
artifacts/*.briefing.txt
artifacts/*.json
artifacts/*.csv
artifacts/*.md
# LangGraph checkpoints and the customer trends evidence store
backend/data/
# Per-worker run products
backend/src/edrak/agents/*/outputs/

# Keep directory placeholders if used
!artifacts/runs/.gitkeep
!artifacts/reports/.gitkeep

# IDE
.vscode/
.idea/

# Local AI agent tooling
.opencode/
.agents/
skills-lock.json

# Graphify local scan config (local-only)
.graphifyignore

# OS
.DS_Store
Thumbs.db

# UI design handoff (reference only, not shipped)
edrak-ui-handoff/

# Generated HTML decks/exports (run products, large binaries)
presentation/
