# EDRAK Environment Configuration

# Application Environment
EDRAK_ENV=development
EDRAK_DEBUG=true

# LLM Generation Configuration (Ollama Cloud / Local OSS)

# One model serves every worker. The LLM_* names are still accepted, but prefer
# these. Structured output uses json_schema with the schema restated in the
# prompt, so prompts need not describe the JSON shape.
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TEMPERATURE=0.2
OLLAMA_BASE_URL=https://ollama.com

# Per-agent LLM credentials

# One credential per agent so an agent exhausting its quota cannot starve the
# others. Lookup order is: the agent's own key, then its _BACKUP, then the
# shared key. An agent never reads another agent's key.
# The shared fallback, used by any agent with no scoped key of its own:
OLLAMA_API_KEY=

# OLLAMA_API_KEY_ORCHESTRATOR=
# OLLAMA_API_KEY_ORCHESTRATOR_BACKUP=

# Competitor worker.
# OLLAMA_API_KEY_COMPETITOR=
# OLLAMA_API_KEY_COMPETITOR_BACKUP=

# Market worker.
# OLLAMA_API_KEY_MARKET=
# OLLAMA_API_KEY_MARKET_BACKUP=

# Internal intelligence worker.
# OLLAMA_API_KEY_INTERNAL=
# OLLAMA_API_KEY_INTERNAL_BACKUP=

# Cross-signal stage.
# OLLAMA_API_KEY_CROSS_SIGNAL=
# OLLAMA_API_KEY_CROSS_SIGNAL_BACKUP=

# Customer-trends worker.
# OLLAMA_API_KEY_CUSTOMER_TRENDS=
# OLLAMA_API_KEY_CUSTOMER_TRENDS_BACKUP=

# Embedding Configuration (Local Hugging Face Static Embeddings)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

EMBEDDING_ALLOW_FALLBACK=False

# Internal Intelligence Worker Reranking & Retrieval Settings
INTERNAL_RERANK_SCORE_CUTOFF=0.58
INTERNAL_RERANK_MAX_ITEMS=12
INTERNAL_RERANK_MIN_ITEMS=5

# RAG relevance floor. A candidate scoring below this is dropped before
# reranking. Raising it makes internal intelligence report less evidence.
RETRIEVAL_MIN_SCORE=0.30

# Orchestration control-plane limits

# How many times the supervisor may re-plan after verification returns
# REPLAN_REQUIRED before it gives up and finalizes. A re-plan re-dispatches only
# the workers whose findings verification found contradictory, keeping every
# other worker's results, so one attempt is normally enough.
MAX_REPLANS=1

# Attempts allowed per individual research task.
MAX_TASK_ATTEMPTS=3

# Company profile import

# Characters of source text sent to the model in one call. Pages past the budget
# are cut, and the draft carries a warning saying so.
PROFILE_IMPORT_CONTEXT_CHARS=48000
# Below this many characters of readable text the draft warns that it is thin.
PROFILE_IMPORT_MIN_CHARS=400
# Reasoning effort for the extraction call: low, medium or high. Empty leaves
# the model's default.
PROFILE_IMPORT_REASONING=low
# Caps applied to the draft: items per list, characters per item, characters in notes.
PROFILE_IMPORT_MAX_LIST_ITEMS=20
PROFILE_IMPORT_MAX_ITEM_CHARS=200
PROFILE_IMPORT_MAX_NOTES_CHARS=600

# Importing from a website
# Pages read per site, homepage included.
PROFILE_IMPORT_MAX_PAGES=8
PROFILE_IMPORT_FETCH_TIMEOUT_S=10
# Largest response read, in bytes. Larger pages are cut.
PROFILE_IMPORT_MAX_BYTES=2000000
PROFILE_IMPORT_CONCURRENCY=3
PROFILE_IMPORT_MAX_REDIRECTS=5
# A homepage with less main text than this is rendered in a headless browser
# (needs: pip install playwright && playwright install chromium).
PROFILE_IMPORT_RENDER_MIN_CHARS=300

# Importing from a PDF
PROFILE_IMPORT_PDF_MAX_MB=20
PROFILE_IMPORT_PDF_MAX_PAGES=60
# A page with fewer characters of text than this, and an image on it, is treated as a scan.
PROFILE_IMPORT_SCANNED_MIN_CHARS=50
# OCR for scanned pages runs only when the Tesseract program is installed together with
# the language data for every language listed here (macOS: brew install tesseract
# tesseract-lang; Debian: apt install tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng).
# Without it, scanned pages are skipped and the draft says which.
PROFILE_IMPORT_OCR_LANGUAGE=ara+eng
PROFILE_IMPORT_OCR_DPI=300

# Company research crawl
# Pages read per site (homepage included), link depth from the homepage, and seconds for the whole crawl.
COMPANY_RESEARCH_CRAWL_MAX_PAGES=40
COMPANY_RESEARCH_CRAWL_MAX_DEPTH=3
COMPANY_RESEARCH_CRAWL_TIME_BUDGET_S=180
COMPANY_RESEARCH_CRAWL_CONCURRENCY=3
# Seconds between requests to the same host.
COMPANY_RESEARCH_CRAWL_HOST_DELAY_S=1
# Largest response read, in bytes.
COMPANY_RESEARCH_CRAWL_MAX_BYTES=2000000
# A page with less main text than this, or one that looks client-rendered or lazy-loaded, is
# opened in a headless browser (needs: pip install playwright && playwright install chromium).
# Without a browser the static text is kept and the crawl carries a warning.
COMPANY_RESEARCH_CRAWL_DYNAMIC=true
COMPANY_RESEARCH_CRAWL_DYNAMIC_MIN_CHARS=300
COMPANY_RESEARCH_CRAWL_MAX_DYNAMIC_PAGES=15
# In the browser: scrolls to the bottom, clicks on "load more" buttons, and tabs or accordions expanded, per page.
COMPANY_RESEARCH_CRAWL_MAX_SCROLLS=8
COMPANY_RESEARCH_CRAWL_SCROLL_PAUSE_MS=600
COMPANY_RESEARCH_CRAWL_MAX_CLICKS=5
COMPANY_RESEARCH_CRAWL_MAX_EXPANDS=20

# Company research PDFs
# PDFs read per run, largest file in MB, pages read per file (later pages are left out), downloads
# tried per run (failures count), and characters of text kept per file.
COMPANY_RESEARCH_PDF_MAX_PDFS=8
COMPANY_RESEARCH_PDF_MAX_MB=20
COMPANY_RESEARCH_PDF_MAX_PAGES=60
COMPANY_RESEARCH_PDF_MAX_ATTEMPTS=24
COMPANY_RESEARCH_PDF_CONTEXT_CHARS=48000

# Company research extraction
# Characters of source text per model call (a document is never split across calls), the most calls
# per run, and how closely a quote must match OCR text (1 = exactly). Other text must match exactly.
COMPANY_RESEARCH_EXTRACT_BATCH_CHARS=24000
COMPANY_RESEARCH_EXTRACT_MAX_BATCHES=30
COMPANY_RESEARCH_EXTRACT_OCR_TOLERANCE=0.9

# Company research run (the graph). Extra rounds read a few more pages of the company's own site
# for important categories that have no facts yet; at most 2 rounds whatever the setting.
COMPANY_RESEARCH_RUN_TIME_BUDGET_S=900
# A run is stopped and failed after this many seconds, whatever step it is in (a model call has no timeout of its own).
COMPANY_RESEARCH_RUN_MAX_S=3600
COMPANY_RESEARCH_IMPORTANT_CATEGORIES=leadership,ownership_and_funding,financials,locations,history
COMPANY_RESEARCH_GAP_MAX_ROUNDS=2
COMPANY_RESEARCH_GAP_MAX_TARGETS=4
# Off by default. When on, empty categories are searched with Serper (SERPER_API_KEY) and the top
# results are read; their facts are marked third_party and never replace the company's own.
COMPANY_RESEARCH_THIRD_PARTY=false
COMPANY_RESEARCH_THIRD_PARTY_MAX_SEARCHES=4
COMPANY_RESEARCH_THIRD_PARTY_MAX_PAGES=6

# Paths

# Relative paths resolve against the repository root. BASE_DIR is derived from
# this file's location and is not a setting; do not set it.
#
# Characters of page text kept per scraped document. Larger costs context
# window for little extra signal past roughly 4000.
SCRAPE_TEXT_CHARS=2000

# ==============================================================================
# External web / data tools
# ==============================================================================
# Only Tavily and Serper are read by more than one worker, so only they are
# scoped. The rest are single-tenant and stay on the bare name.
NEWS_API_KEY=
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
OPENALEX_MAILTO=
SCRAPER_USER_AGENT=edrak-web/1.0

# Market and competitor share Tavily. Same rule as the LLM keys above.
# TAVILY_API_KEY_MARKET=
# TAVILY_API_KEY_MARKET_BACKUP=
# TAVILY_API_KEY_COMPETITOR=
# TAVILY_API_KEY_COMPETITOR_BACKUP=

# Market and customer-trends share Serper.
# SERPER_API_KEY_MARKET=
# SERPER_API_KEY_MARKET_BACKUP=
# SERPER_API_KEY_CUSTOMER_TRENDS=
# SERPER_API_KEY_CUSTOMER_TRENDS_BACKUP=

# Customer-trends providers. All single-tenant to this worker.
#
# A provider with no key is skipped silently, so a missing key looks the same
# as finding nothing.
#
# APIFY_TOKEN=
# APIFY_FALLBACK_TOKENS=
# SOCIALCRAWL_API_KEY=
# SOCIALCRAWL_FALLBACK_API_KEYS=

# Not a secret. Empty keeps the default, https://www.socialcrawl.dev/v1
# SOCIALCRAWL_BASE_URL=

# YOUTUBE_API_KEY=
# GOOGLE_TRENDS_API_KEY=

# Data Storage & RAG Paths
VECTOR_STORE_PATH=data/vector_store
INTERNAL_DATA_PATH=data/internal
RAW_HANDBOOK_PATH=data/handbook/raw
CLEANED_HANDBOOK_PATH=data/handbook/cleaned
CHUNKED_HANDBOOK_PATH=data/handbook/chunked
ARTIFACTS_PATH=artifacts
CHROMA_COLLECTION_NAME=edrak_internal_knowledge

# The metrics agent fills figures after verification. false skips it. The brief is still built.
# A value here overrides the default in config.py.
METRICS_GATHERING_ENABLED=false

# Decision personalization. Tags are stored either way. These three change what is read.
# How many relevant past decisions are scored.
PERSONALIZATION_HISTORY_K=20
# Minimum cosine similarity for a past decision to count.
PERSONALIZATION_SIMILARITY_MIN=0.55
# Personalization stays off unless this many decisions pass the threshold, and unless
# one aspect has a score of at least this value or is carried by at least this many decisions.
PERSONALIZATION_ASPECT_BAR=2

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# JEVStation (JEV semantic evaluations via https://jevstation.com/docs)
# Empty by default. Export a real key only in your local gitignored .env;
# never commit a key here.
JEVSTATION_API_KEY=
# Hook A semantic layer in check_query. Off by default; deterministic checks always run.
JEV_GUARD_ENABLED=false
JEV_HIGH=0.85
JEV_REVIEW=0.5
JEV_TIMEOUT_S=8.0
JEV_MAX_CALLS_PER_DAY=40