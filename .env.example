# ============================
# EDRAK
# ============================

EDRAK_ENV=development
EDRAK_DEBUG=true

# ============================
# LLM
# ============================

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_KEY=

# ============================
# External web / data tools
# ============================

NEWS_API_KEY=
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
SERPER_API_KEY=
OPENALEX_MAILTO=
SCRAPER_USER_AGENT=edrak-web/1.0

# ============================
# Paths
# ============================

VECTOR_STORE_PATH=data/vector_store
INTERNAL_DATA_PATH=data/internal
ARTIFACTS_PATH=artifacts

# ============================
# API
# ============================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000