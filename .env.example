# ============================
# EDRAK
# ============================

ENV=development
DEBUG=true

# ============================
# LLM
# ============================
# Field names map 1:1 to these variables; there is no EDRAK_ prefix.

LLM_PROVIDER=ollama
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gpt-oss:120b
# Required. Create at https://ollama.com/settings/keys
LLM_API_KEY=
# gpt-oss expects its harmony defaults; do not set this to 0.
LLM_TEMPERATURE=1.0

# ============================
# Orchestration limits
# ============================

MAX_REPLANS=2
MAX_TASK_ATTEMPTS=3

# ============================
# Paths
# ============================

VECTOR_STORE_PATH=data/vector_store
INTERNAL_DATA_PATH=data/internal
ARTIFACTS_PATH=artifacts

# ============================
# API
# ============================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000