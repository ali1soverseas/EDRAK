# ============================
# EDRAK
# ============================

ENV=development
DEBUG=true

# ============================
# LLM
# ============================
# Field names map 1:1 to these variables; there is no EDRAK_ prefix.

LLM_PROVIDER=ollama
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gpt-oss:120b
# Required. Create at https://ollama.com/settings/keys
LLM_API_KEY=
# gpt-oss expects its harmony defaults; do not set this to 0.
LLM_TEMPERATURE=1.0

# ============================
# Orchestration limits
# ============================

MAX_REPLANS=2
MAX_TASK_ATTEMPTS=3

# ============================
# Paths
# ============================

VECTOR_STORE_PATH=data/vector_store
INTERNAL_DATA_PATH=data/internal
ARTIFACTS_PATH=artifacts

# ============================
# API
# ============================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ============================
# Customer & Trends worker
# ============================

# LLM (Ollama Cloud)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
OLLAMA_MODEL_ANALYSIS=            # optional, falls back to OLLAMA_MODEL
OLLAMA_MODEL_RELEVANCE=           # optional, the comment relevance filter; falls back to OLLAMA_MODEL
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_S=120

# Data providers
APIFY_TOKEN=
APIFY_FALLBACK_TOKENS=             # optional, comma separated, used when the token above runs out
SOCIALCRAWL_API_KEY=
SOCIALCRAWL_FALLBACK_API_KEYS=      # optional, comma separated, used when the key above runs out
SOCIALCRAWL_BASE_URL=https://www.socialcrawl.dev/v1
YOUTUBE_API_KEY=
SERPER_API_KEY=
GOOGLE_TRENDS_API_KEY=            # optional, alpha, usually empty

# Runtime
EDRAK_DATA_DIR=./data
EDRAK_PROVIDER_MODE=live          # live | fixture
EDRAK_FIXTURES_DIR=               # optional, where fixture mode reads; default: the demo fixtures
EDRAK_CACHE_TTL_S=86400
EDRAK_LOG_LEVEL=INFO
EDRAK_FAKE_LLM=false               # true: UI and CLI use the scripted fake model
BRANCH_MAX_STEPS=8                 # model calls each collection branch may make
BRANCH_TIMEOUT_S=100               # wall clock seconds each collection branch may take
RELEVANCE_FILTER_ENABLED=true      # false: no filtering of collected comments before analysis
RELEVANCE_ITEM_TYPES=social_comment   # comma separated source types the filter handles
RELEVANCE_BATCH_SIZE=40            # comments per filter model call
RELEVANCE_PARENT_CHARS=300         # parent post characters sent with its comments
RELEVANCE_COMMENT_CHARS=280        # characters of each comment sent to the model
RELEVANCE_CONCURRENCY=2            # filter model calls in flight at once
RELEVANCE_MIN_RELEVANT=5           # fewer relevant comments on a platform adds a gap note
RELEVANCE_TIMEOUT_S=60             # wall clock for all filter model calls
RELEVANCE_REASONING=low            # reasoning effort of the filter model
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_SEARCH_DAILY_CAP=100

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
