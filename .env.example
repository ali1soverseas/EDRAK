# ==============================================================================
# EDRAK Environment Configuration
# ==============================================================================

# Application Environment
EDRAK_ENV=development
EDRAK_DEBUG=true

# ==============================================================================
# LLM Generation Configuration (Ollama Cloud / Local OSS)
# ==============================================================================
# One model serves every worker. The LLM_* names are still accepted, but
# prefer these. Structured output relies on tool calling, so leave the JSON
# shape out of prompts and let the schema carry it.
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TEMPERATURE=0.2
# Only set this to point at a local Ollama server. It must be the bare host,
# with no /v1 suffix: customer-trends reads this variable and ChatOllama does
# not speak the OpenAI-compatible shim path.
OLLAMA_BASE_URL=https://ollama.com

# ==============================================================================
# Per-agent LLM credentials
# ==============================================================================
# Each developer puts their own account's key in their own block, so an agent
# exhausting its quota cannot starve the others. Uncomment only your own.
#
#   Lookup order is: the agent's own key, then its _BACKUP, then the shared key.
#   An agent never reads another agent's key.
#
# The shared fallback, used by any agent with no scoped key of its own:
OLLAMA_API_KEY=

# Control plane: the planner, verification, and the request builder.
# OLLAMA_API_KEY_ORCHESTRATOR=
# OLLAMA_API_KEY_ORCHESTRATOR_BACKUP=

# Competitor worker.
# OLLAMA_API_KEY_COMPETITOR=
# OLLAMA_API_KEY_COMPETITOR_BACKUP=

# Market worker.
# OLLAMA_API_KEY_MARKET=
# OLLAMA_API_KEY_MARKET_BACKUP=

# Internal intelligence worker.
# OLLAMA_API_KEY_INTERNAL=
# OLLAMA_API_KEY_INTERNAL_BACKUP=

# Cross-signal stage.
# OLLAMA_API_KEY_CROSS_SIGNAL=
# OLLAMA_API_KEY_CROSS_SIGNAL_BACKUP=

# Customer-trends worker.
# OLLAMA_API_KEY_CUSTOMER_TRENDS=
# OLLAMA_API_KEY_CUSTOMER_TRENDS_BACKUP=

# ==============================================================================
# Embedding Configuration (Local Hugging Face Static Embeddings)
# ==============================================================================
# Model recommendations from Hugging Face:
# - sentence-transformers/all-MiniLM-L6-v2 (Default: 384-dim, fast, lightweight, ONNX-supported)
# - BAAI/bge-small-en-v1.5 (384-dim, high accuracy MTEB benchmark)
# - BAAI/bge-base-en-v1.5 (768-dim, top tier accuracy)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# When true, and neither ONNX nor SentenceTransformers is installed, retrieval
# falls back to a deterministic local embedder instead of raising. Leave false:
# the fallback returns plausible but meaningless vectors, so RAG retrieval
# quietly finds nothing and the symptom looks like absent documents rather than
# a broken install.
EMBEDDING_ALLOW_FALLBACK=False

# ==============================================================================
# Internal Intelligence Worker Reranking & Retrieval Settings
# ==============================================================================
INTERNAL_RERANK_SCORE_CUTOFF=0.58
INTERNAL_RERANK_MAX_ITEMS=12
INTERNAL_RERANK_MIN_ITEMS=5

# RAG relevance floor. A candidate scoring below this is dropped before
# reranking. Raising it makes internal intelligence report less evidence.
RETRIEVAL_MIN_SCORE=0.30

# ==============================================================================
# Orchestration control-plane limits
# ==============================================================================
# How many times the supervisor may re-plan after verification returns
# REPLAN_REQUIRED before it gives up and finalizes. A re-plan re-dispatches only
# the workers whose findings verification found contradictory, keeping every
# other worker's results, so one attempt is normally enough.
MAX_REPLANS=1

# Attempts allowed per individual research task.
MAX_TASK_ATTEMPTS=3

# ==============================================================================
# Paths
# ==============================================================================
# Relative paths resolve against the repository root. BASE_DIR is derived from
# this file's location and is not a setting; do not set it.
#
# Characters of page text kept per scraped document. Larger costs context
# window for little extra signal past roughly 4000.
SCRAPE_TEXT_CHARS=2000

# ==============================================================================
# External web / data tools
# ==============================================================================
# Only Tavily and Serper are read by more than one worker, so only they are
# scoped. The rest are single-tenant and stay on the bare name.
NEWS_API_KEY=
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
OPENALEX_MAILTO=
SCRAPER_USER_AGENT=edrak-web/1.0

# Market and competitor share Tavily. Same rule as the LLM keys above.
# TAVILY_API_KEY_MARKET=
# TAVILY_API_KEY_MARKET_BACKUP=
# TAVILY_API_KEY_COMPETITOR=
# TAVILY_API_KEY_COMPETITOR_BACKUP=

# Market and customer-trends share Serper.
# SERPER_API_KEY_MARKET=
# SERPER_API_KEY_MARKET_BACKUP=
# SERPER_API_KEY_CUSTOMER_TRENDS=
# SERPER_API_KEY_CUSTOMER_TRENDS_BACKUP=

# Customer-trends providers. All single-tenant to this worker.
#
# A provider with no key is skipped silently, so a missing key looks the same
# as finding nothing.
#
# Comma separated, and rotated within this worker only. Never put a key here
# that another worker also uses: a fallback that crosses workers reintroduces
# exactly the shared-quota problem the scoped names exist to prevent.
# APIFY_TOKEN=
# APIFY_FALLBACK_TOKENS=
# SOCIALCRAWL_API_KEY=
# SOCIALCRAWL_FALLBACK_API_KEYS=

# Not a secret. Empty keeps the default, https://www.socialcrawl.dev/v1
# SOCIALCRAWL_BASE_URL=

# YOUTUBE_API_KEY=
# GOOGLE_TRENDS_API_KEY=

# ============================
# Paths
# ============================

# ==============================================================================
# Data Storage & RAG Paths
# ==============================================================================
VECTOR_STORE_PATH=data/vector_store
INTERNAL_DATA_PATH=data/internal
RAW_HANDBOOK_PATH=data/handbook/raw
CLEANED_HANDBOOK_PATH=data/handbook/cleaned
CHUNKED_HANDBOOK_PATH=data/handbook/chunked
ARTIFACTS_PATH=artifacts
CHROMA_COLLECTION_NAME=edrak_internal_knowledge

# ==============================================================================
# Backend Server
# ==============================================================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000