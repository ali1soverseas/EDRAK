{
  "openapi": "3.1.0",
  "info": {
    "title": "NVIDIA Internal Enterprise Operations API",
    "description": "Operational microservices API for real-time cluster telemetry, pricing rules, competitive benchmarks, ARR financials, supply-chain constraints, and export control data. Read-only GET endpoints only. POST/PATCH/DELETE exist in spec for completeness but must never be invoked by AI agents.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8088",
      "description": "Local Mock NVIDIA Enterprise Service"
    }
  ],
  "paths": {
    "/v1/telemetry/gpu-clusters": {
      "get": {
        "summary": "Retrieve Global GPU Cluster Telemetry",
        "description": "Returns live operational metrics on NVIDIA global compute cluster utilization, deployed Blackwell units, and uptime.",
        "operationId": "get_cluster_telemetry_v1_telemetry_gpu_clusters_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterTelemetryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pricing/discount-matrix": {
      "get": {
        "summary": "Get Volume Discount Policy & Deal Desk Matrix",
        "description": "Returns current discount approval thresholds, volume tiers, and minimum margin floors.",
        "operationId": "get_discount_matrix_v1_pricing_discount_matrix_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingDiscountMatrixResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/supply-chain/lead-times": {
      "get": {
        "summary": "Get Hardware Lead Times & Packaging Allocation",
        "description": "Returns estimated customer shipment lead times by GPU model and CoWoS packaging allocation.",
        "operationId": "get_supply_chain_lead_times_v1_supply_chain_lead_times_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupplyChainLeadTimesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products": {
      "get": {
        "summary": "List All GPU Products & ASP",
        "description": "Returns the full NVIDIA GPU product catalogue with ASP and gross margin targets.",
        "operationId": "list_products_v1_products_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductSummary"
                  },
                  "type": "array",
                  "title": "Response List Products V1 Products Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{product_name}/margin": {
      "get": {
        "summary": "Get Gross Margin for a Specific Product",
        "description": "Looks up the gross margin target and remaining headroom above floor for a specific GPU product.",
        "operationId": "get_product_margin_v1_products__product_name__margin_get",
        "parameters": [
          {
            "name": "product_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Product name, e.g. B200 GPU",
              "title": "Product Name"
            },
            "description": "Product name, e.g. B200 GPU"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductMarginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/competitive/benchmark-summary": {
      "get": {
        "summary": "Get Competitive Benchmark Summary vs AMD & Google",
        "description": "Returns training and inference benchmark comparisons between NVIDIA GPUs and competitors.",
        "operationId": "get_competitive_benchmarks_v1_competitive_benchmark_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitiveBenchmarkSummary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/finance/arr-summary": {
      "get": {
        "summary": "Get Software ARR Breakdown (FY2026)",
        "description": "Returns the software and subscription ARR breakdown across NVIDIA AI Enterprise, NIM, DGX Cloud, and Omniverse.",
        "operationId": "get_arr_summary_v1_finance_arr_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ARRSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/export-control/{country}": {
      "get": {
        "summary": "Get Export Control Status for a Country or Entity",
        "description": "Returns the US BIS / OFAC export control status for a specific country or named entity.",
        "operationId": "get_export_control_v1_export_control__country__get",
        "parameters": [
          {
            "name": "country",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Country name or entity, e.g. China",
              "title": "Country"
            },
            "description": "Country name or entity, e.g. China"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportControlResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/deals/create": {
      "post": {
        "summary": "[WRITE] Create a New Enterprise Deal Record",
        "description": "WRITE OPERATION \u2013 AI agents are PROHIBITED from calling this endpoint. Reserved for Deal Desk system automation only.",
        "operationId": "create_deal_v1_deals_create_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDealRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Create Deal V1 Deals Create Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/supply-chain/emergency-order": {
      "post": {
        "summary": "[WRITE] Place Emergency Supply Order",
        "description": "WRITE OPERATION \u2013 AI agents are PROHIBITED from calling this endpoint.",
        "operationId": "place_emergency_order_v1_supply_chain_emergency_order_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmergencyOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Place Emergency Order V1 Supply Chain Emergency Order Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pipeline/{opportunity_id}": {
      "delete": {
        "summary": "[WRITE] Delete Sales Pipeline Opportunity",
        "description": "WRITE OPERATION \u2013 AI agents are PROHIBITED from calling this endpoint.",
        "operationId": "delete_opportunity_v1_pipeline__opportunity_id__delete",
        "parameters": [
          {
            "name": "opportunity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Opportunity Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Delete Opportunity V1 Pipeline  Opportunity Id  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pricing/override": {
      "patch": {
        "summary": "[WRITE] Override Pricing Policy",
        "description": "WRITE OPERATION \u2013 AI agents are PROHIBITED from calling this endpoint.",
        "operationId": "override_pricing_v1_pricing_override_patch",
        "parameters": [
          {
            "name": "margin_floor",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Margin Floor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Override Pricing V1 Pricing Override Patch"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
